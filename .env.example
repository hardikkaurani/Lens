# ==============================================================================
# LENS — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and update the values for your local environment:
#   cp .env.example .env
#
# CRITICAL SECURITY RULE:
# NEVER commit the actual '.env' or any credential file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector Configuration (Local Infrastructure)
# ------------------------------------------------------------------------------
POSTGRES_DB=lens
POSTGRES_USER=lens_user
POSTGRES_PASSWORD=lens_password
# Assembled database connection string for API / Worker services
DATABASE_URL=postgresql://lens_user:lens_password@localhost:5432/lens

# ------------------------------------------------------------------------------
# Redis Cache & Task Queue Configuration (Local Infrastructure)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# S3 / MinIO Object Storage Configuration (Local Infrastructure)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lens-media
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# Security & Authentication (PLANNED — Not required for Stage 2)
# ------------------------------------------------------------------------------
JWT_SECRET=change-this-insecure-secret-to-a-random-32-byte-hex-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# GitHub Integration (PLANNED — Not required for Stage 2)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# AI & Embedding Providers (PLANNED — Not required for Stage 2)
# ------------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=your_ai_provider_api_key_here
