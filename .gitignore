# ==========================================
# LENS - Monorepo Root .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Explicitly allow safe example template files
!.env.example
!.env.*.example

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# IDE & Editor Files
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------
# Logs & Diagnostic Outputs
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Node.js / Next.js / TypeScript
# ------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js
.next/
out/
dist/
build/
.tsbuildinfo
.eslintcache
.stylelintcache
.turbo/

# ------------------------------------------
# Python / FastAPI / Worker
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------
# Flutter / Dart
# ------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/

# ------------------------------------------
# Android (Mobile)
# ------------------------------------------
.gradle/
**/android/captures/
**/android/.gradle/
local.properties
*.apk
*.aab

# ------------------------------------------
# Docker & Local Data Persistence
# ------------------------------------------
.docker/
docker-compose.override.yml
*.cid
*.pid
